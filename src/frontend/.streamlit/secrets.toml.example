# Copiez ce fichier en .streamlit/secrets.toml pour activer Google OAuth natif
[auth]
redirect_uri = "http://localhost:8501/oauth2callback"
cookie_secret = "remplacer-par-une-cle-secrete-aleatoire-longue"
client_id = "VOTRE_GOOGLE_CLIENT_ID.apps.googleusercontent.com"
client_secret = "VOTRE_GOOGLE_CLIENT_SECRET"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
